# ==============================================================================
# KONFIGURASI AWS & APLIKASI PENGUMPULAN TUGAS SISWA TKJ
# Salin file ini menjadi .env: cp sample.env .env
# Kredensial AWS otomatis dibaca dari IAM Role (LabInstanceProfile) pada EC2.
# ==============================================================================

# Tema Tampilan Aplikasi: BLUE atau GREEN
STYLE=BLUE

# AWS Region (contoh: us-east-1, ap-southeast-1)
AWS_DEFAULT_REGION=us-east-1

# Nama Tabel DynamoDB (Partition Key: id [String])
DYNAMODB_TABLE_NAME=tkj_tugas

# Nama Bucket S3 (Private - Block Public Access ON)
S3_BUCKET_NAME=tkj-tugas-siswa-smk

# Port Server Aplikasi
PORT=5000
