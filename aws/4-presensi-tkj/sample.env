# ==============================================================================
# AWS & APPLICATION CONFIGURATION TEMPLATE
# Copy this file to .env: cp sample.env .env
# AWS credentials are automatically resolved via EC2 IAM Role (LabInstanceProfile).
# ==============================================================================

# Application UI Theme: INDIGO, EMERALD, or BLUE
STYLE=INDIGO

# Target AWS Region (e.g., us-east-1, ap-southeast-1)
AWS_DEFAULT_REGION=us-east-1

# Amazon DynamoDB Table Name (Partition Key: id [String])
DYNAMODB_TABLE_NAME=tkj_presensi

# Amazon S3 Bucket Name (Private - Block All Public Access ON)
S3_BUCKET_NAME=tkj-presensi-siswa-smk

# Application Server Port
PORT=5000

# Optional: Only needed for local testing without IAM Role
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
